# Copy to .env and fill in. Never commit .env.
# Every TEXT2ICD_* variable maps to a field of text2icd.config.Settings.

# Where local data lives (see data/README.md) and where result caches go. Both are git-ignored.
TEXT2ICD_DATA_DIR=./data
TEXT2ICD_CACHE_DIR=./.text2icd

# ICD-10-CM release id, for example fy2026 or fy2026-apr. Empty means the newest registered release.
TEXT2ICD_RELEASE=

# LLM navigator (L3). "none" runs the deterministic cascade only (L0-L2). Otherwise name a
# provider implemented in text2icd.llm.providers (anthropic, bedrock or vertex) and a model
# listed for it in src/text2icd/resources/prices.toml. Each provider's SDK reads its own
# credentials: ANTHROPIC_API_KEY (or TEXT2ICD_LLM_API_KEY) for anthropic, the AWS credential
# chain for bedrock, Application Default Credentials for vertex.
TEXT2ICD_LLM_PROVIDER=none
TEXT2ICD_LLM_MODEL=
TEXT2ICD_LLM_API_KEY=
# bedrock: the AWS region (else AWS_REGION). vertex: the Google Cloud region (else
# CLOUD_ML_REGION, else global) and project.
TEXT2ICD_LLM_REGION=
TEXT2ICD_LLM_PROJECT=

# Refuse to send text to any endpoint not listed as approved for MIMIC-IV work.
# Keep this true whenever inputs come from MIMIC-IV (see docs/data-and-compliance.md).
TEXT2ICD_REQUIRE_DUA_COMPLIANT_ENDPOINT=true

# Hard limits for the LLM navigator: calls per phrase, US dollars per run, seconds per attempt,
# and retries of retryable errors (rate limits, server and network errors) only.
TEXT2ICD_LLM_MAX_CALLS_PER_PHRASE=4
TEXT2ICD_LLM_BUDGET_USD=1.00
TEXT2ICD_LLM_TIMEOUT_S=30
TEXT2ICD_LLM_MAX_RETRIES=2

# Episode of care assumed for an injury's 7th character when the phrase states none
# (initial, subsequent or sequela); the code is flagged seventh_character_assumed.
TEXT2ICD_DEFAULT_EPISODE=initial

# A confidence calibration table written by `text2icd eval calibrate`, for example one fitted on
# local MIMIC-IV data (never commit it). Empty uses the table shipped with the package.
TEXT2ICD_CALIBRATION=
